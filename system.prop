# Audio
ro.audio.silent=0

# Display
ro.opengles.version=196610

# Wi-Fi
ro.wifi.channels=
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.tethering.interface=ap0

# Miscellaneous
dalvik.vm.lockprof.threshold=500
dalvik.vm.stack-trace-dir=/data/anr
mediatek.wlan.ctia=0
net.bt.name=Android
persist.mediascan.foldcnt=256
persist.mediascan.foldlevel=8
persist.mediascanner.audio.cnt=3000
persist.mediascanner.fileCnt=0
persist.mediascanner.image.cnt=1500
persist.mediascanner.slpTimeMs=0
persist.mediascanner.sperate.scan=1
persist.mediascanner.video.cnt=500
persist.sys.dalvik.vm.lib.2=libart.so
qemu.hw.mainkeys=1
ro.art.hiddenapi.warning=1
ro.atc.aosp_enhancement=1
ro.bionic.ld.warning=1
ro.camera.sound.forced=0
ro.expect.recovery_id=0x2428feb8849f4ed4f05ecfbb124b411cdf91d5eb000000000000000000000000
ro.external_rotation=0
ro.input.external=Extern
ro.kernel.zio=38,108,105,16
ro.mediatek.wlan.p2p=1
ro.mediatek.wlan.wsc=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1
ro.mtk_perf_simple_start_win=1
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
ro.zygote.preload.enable=0
sys.ipo.disable=1
sys.ipo.pwrdncap=2
vendor.rild.libargs=-d /dev/ttyC0
vendor.rild.libpath=mtk-ril.so

