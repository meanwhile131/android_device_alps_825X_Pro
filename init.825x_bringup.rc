# The platform-only precompiled sepolicy has no domains for the stock vendor
# HALs, so init refuses to start their own rc services ("Could not get process
# context"). Start the ones needed for boot here with an explicit init context.
service vendor_audio_hal_fix /vendor/bin/hw/android.hardware.audio@4.0-service-mediatek
    class hal
    user root
    group root
    seclabel u:r:init:s0

service vendor_light_hal_fix /vendor/bin/hw/android.hardware.light@2.0-service-mediatek
    class hal
    user root
    group root
    seclabel u:r:init:s0

service vendor_wmt_loader_fix /vendor/bin/wmt_loader
    class hal
    user root
    group root
    seclabel u:r:init:s0
    oneshot

service vendor_wmt_launcher_fix /vendor/bin/wmt_launcher -p /vendor/firmware/
    class hal
    user root
    group root
    seclabel u:r:init:s0
    oneshot

service vendor_wifi_hal_fix /vendor/bin/hw/android.hardware.wifi@1.0-service-mediatek
    class hal
    user root
    group root
    seclabel u:r:init:s0

service vendor_gnss_hal_fix /vendor/bin/hw/vendor.mediatek.hardware.gnss@1.1-service
    class hal
    user root
    group root
    seclabel u:r:init:s0

service vendor_power_hal_fix /vendor/bin/hw/android.hardware.power@1.0-service
    class hal
    user root
    group root
    seclabel u:r:init:s0

# Sets vendor.service.nvram_init=Ready. The stock rc only starts this from
# vold.decrypt triggers, which never fire on this FBE device; without it the
# BT HAL spends 5 s waiting for NVRAM and trips the 4 s BLE start timeout.
service vendor_nvram_daemon_fix /vendor/bin/nvram_daemon
    user root
    group root system radio wifi audio bluetooth media
    seclabel u:r:init:s0
    oneshot

service vendor_ril_fix /vendor/bin/hw/mtkfusionrild -l libmtk-ril.so
    class hal
    user root
    group root radio
    seclabel u:r:init:s0
    socket rild-oem stream 660 radio system
    socket rild-atci stream 660 root radio

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    start vendor_audio_hal_fix
    start vendor_light_hal_fix
    start vendor_wmt_loader_fix
    start vendor_wmt_launcher_fix
    start vendor_wifi_hal_fix
    start vendor_gnss_hal_fix
    start vendor_power_hal_fix
    start vendor_nvram_daemon_fix
    start keystore
    start installd
    start zygote
    start zygote_secondary
    start netd
    start storaged
    start wificond
    start media
    start cameraserver
    start mediaextractor
    start vendor_ril_fix
    start mcu_keys

