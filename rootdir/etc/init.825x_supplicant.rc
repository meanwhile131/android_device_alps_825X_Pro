# wificond starts the supplicant with "ctl.start wpa_supplicant".
# The stock definition lives in init.connectivity.rc, which is installed under
# /vendor/etc/init/hw/ and is therefore never imported by init. Provide the
# service in /vendor/etc/init/ so the HIDL supplicant HAL can start.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    disabled
    oneshot
